<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="GP16Editor.Views.ProgressPopup"
             Color="#CC000000">
    <Border BackgroundColor="{DynamicResource ContentBackgroundColor}"
            Stroke="{DynamicResource BorderColor}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 12"
            Padding="32,28"
            MinimumWidthRequest="300">
        <VerticalStackLayout Spacing="16">
            <Label Text="Loading patches..."
                   FontSize="16"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{DynamicResource TextColor}" />
            <VerticalStackLayout Spacing="4">
                <Label x:Name="BytesLabel"
                       Text="Data received: 0 / 16384 bytes"
                       FontSize="12"
                       HorizontalOptions="Center"
                       TextColor="{DynamicResource TextColor}"
                       Opacity="0.7" />
                <ProgressBar x:Name="BytesProgressBar"
                             Progress="0"
                             HeightRequest="6" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="4">
                <Label x:Name="ProgressLabel"
                       Text="Patches parsed: 0 / 128"
                       FontSize="12"
                       HorizontalOptions="Center"
                       TextColor="{DynamicResource TextColor}"
                       Opacity="0.7" />
                <ProgressBar x:Name="ProgressBar"
                             Progress="0"
                             HeightRequest="6" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
